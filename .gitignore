# =========================
# Rust & Tauri (Backend)
# =========================
# Ignore Cargo build directories (Tauri usually nests this in src-tauri)
/src-tauri/target/
target/
# NOTE: Cargo.lock is intentionally NOT ignored because Tauri builds an executable binary.

# Rust backups and debug files
**/*.rs.bk
*.pdb

# =========================
# VS Code / IDEs
# =========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

.idea/
.history/
*.vsix
*.sln
*.suo
*.ntvs*
*.njsproj
.ionide

# =========================
# OS / System Files
