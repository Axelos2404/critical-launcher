# =========================
# Node & React (Frontend)
# =========================
node_modules/
dist/
dist-ssr/
build/
*.local

# Node Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
